# Copy this file to .dev.vars (gitignored) and fill in real values for local `wrangler dev`.

# Gmail OAuth client ID, from the Google Cloud Console credentials page.
GMAIL_CLIENT_ID=your-gmail-oauth-client-id

# Gmail OAuth client secret, from the same credentials page.
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret

# The redirect URI registered for this OAuth client in the Google Cloud
# Console, e.g. http://localhost:8787/auth/gmail/callback for local dev.
GMAIL_REDIRECT_URI=http://localhost:8787/auth/gmail/callback

# Resend API key (https://resend.com), used for outbound email notifications.
RESEND_API_KEY=your-resend-api-key

# Base64-encoded 256-bit key used to AES-256-GCM encrypt the Gmail OAuth
# token at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# The single user's own email address -- where capture-health, budget,
# and bill-reminder notifications are sent.
NOTIFICATION_EMAIL=you@example.com

# The frontend's own origin, used by /auth/gmail/callback to redirect back
# into the app after a Gmail connect/reconnect attempt (success or
# failure) instead of ending on a bare Worker response. The Vite dev
# server's own default port is 5173.
FRONTEND_BASE_URL=http://localhost:5173

# Optional: omit the key to disable AI suggestions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
